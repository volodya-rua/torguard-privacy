{
  "manifest_version": 3,
  "name": "TorGuard Privacy",
  "version": "1.3.0",
  "description": "Routes browser traffic through Tor with a circuit per site, and blocks fingerprinting, WebRTC leaks and tracking. Optionally incognito only.",
  "permissions": ["proxy", "privacy", "storage", "scripting", "declarativeNetRequest", "alarms", "cookies", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png"
  }
}
